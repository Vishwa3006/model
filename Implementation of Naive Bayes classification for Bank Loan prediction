import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix


data = {
    'Age': [25, 45, 35, 33, 52, 23, 40, 60, 48, 33],
    'Income': [50000, 64000, 58000, 72000, 80000, 45000, 52000, 90000, 75000, 62000],
    'CreditScore': [650, 700, 620, 720, 680, 590, 610, 790, 720, 660],
    'LoanApproved': ['No', 'Yes', 'No', 'Yes', 'Yes', 'No', 'No', 'Yes', 'Yes', 'Yes']
}

df = pd.DataFrame(data)


X = df[['Age', 'Income', 'CreditScore']]
y = df['LoanApproved']

label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)

X_train, X_test, y_train, y_test = train_test_split(X, y_encoded, test_size=0.3, random_state=42)


model = GaussianNB()
model.fit(X_train, y_train)


y_pred = model.predict(X_test)


print("Accuracy:", accuracy_score(y_test, y_pred))
print("\nClassification Report:\n", classification_report(y_test, y_pred))
print("\nConfusion Matrix:\n", confusion_matrix(y_test, y_pred))

